<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>MyRainbow</AssemblyName>
		<OutputType>Exe</OutputType>
		<PackageId>MyRainbow</PackageId>
		<UserSecretsId>aspnet-MyRainbow-20161203120550</UserSecretsId>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<AssemblyVersion>1.0.4.0</AssemblyVersion>
		<FileVersion>1.0.4.0</FileVersion>
		<Version>1.0.4</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;TRACE;ENABLE_COSMOS_DB</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="DBScripts\CosmosDB-bulkImport.js" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="DBScripts\CosmosDB-bulkImport.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Update="DBScripts\CosmosDB-bulkDelete.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="DBScripts\**\*">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.60.0" Condition="$(DefineConstants.Contains('ENABLE_COSMOS_DB'))" />
		<PackageReference Include="MongoDB.Driver" Version="3.8.1" />
		<PackageReference Include="CassandraCSharpDriver" Version="3.22.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
		<PackageReference Include="MySqlConnector" Version="2.5.0" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="StackExchange.Redis" Version="2.13.10" />
	</ItemGroup>

</Project>
